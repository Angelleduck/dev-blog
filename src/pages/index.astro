---
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import LatestPost from "../components/LatestPost.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "@/assets/Image.png";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <Header />
  <section class="cs-container relative mb-36">
    <Image src={Hero} alt={"Illustration"} />
    <div
      class="absolute bg-white shadow-sm max-w-149.5 rounded-xl left-10
    -bottom-10 p-10"
    >
      <p class="font-semibold text-[36px] leading-10 mb-6">
        The Impact of Technology on the Workplace: How Technology is Changing
      </p>
    </div>
  </section>
  <div class="max-w-187.5 h-25 bg-[#E8E8EA] mx-auto mb-20 items-center justify-center flex">
    <p class="text-2xl text-[#696A75] font-semibold">Advertisement</p>
  </div>
  <LatestPost />
  <Footer />
</Layout>
